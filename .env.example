# --- France Travail (API Offres d'emploi v2, gratuite) ---
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_SCOPE=api_offresdemploiv2 o2dsoffre

# --- Sécurité sessions (mets une longue chaîne aléatoire) ---
JWT_SECRET=change-moi-par-une-longue-chaine-aleatoire

# --- E-mail des alertes (Brevo, gratuit 300/jour) ---
BREVO_API_KEY=
MAIL_FROM=tonadresse@exemple.fr
MAIL_FROM_NAME=JobRadar

# --- Stockage & options ---
DATA_FILE=./data/db.json
# RUN_CRON=1 uniquement si l'hôte est TOUJOURS actif. En gratuit, on utilise GitHub Actions à la place.
RUN_CRON=0
CRON_EXPR=*/20 * * * *
